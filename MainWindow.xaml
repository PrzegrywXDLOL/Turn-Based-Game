<Window x:Class="Turn_Based_Game.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Turn_Based_Game" xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Turn Based Game" Height="650" Width="1000"
        ResizeMode="NoResize">

    <Grid Background="SkyBlue">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.25*"/>
            <RowDefinition/>
            <RowDefinition Height="0.25*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0"
                   x:Name="Player1Name" Text="Player 1 Placeholder">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TopInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding p1Turn}" Value="True">
                            <Setter Property="Foreground" Value="Gold"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding p1Turn}" Value="False">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Normal"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        
        <TextBlock Grid.Row="0" Grid.Column="1"
                   x:Name="Player2Name" Text="Player 2 Placeholder">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TopInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding p1Turn}" Value="True">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Normal"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding p1Turn}" Value="False">
                            <Setter Property="Foreground" Value="Gold"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ProgressBar Grid.Row="0" Grid.Column="0" 
                     x:Name="Player1HP" Value="0"
                     Style="{StaticResource ProgressBarWithText}"/>

        <ProgressBar Grid.Row="0" Grid.Column="1"
                     x:Name="Player2HP" Value="0"
                     Style="{StaticResource ProgressBarWithText}"/>

        <Image Style="{StaticResource Buffs}" Grid.Column="0" 
               Grid.Row="1" x:Name="pl1Buff" Source=""/>

        <Image Style="{StaticResource Buffs}" Grid.Column="1" 
               Grid.Row="1" x:Name="pl2Buff" Source=""/>

        <Image Style="{StaticResource Sprites}" Grid.Column="0" 
               Grid.Row="1" x:Name="pl1Sprite" Source=""/>

        <Image Style="{StaticResource Sprites}" Grid.Column="1" 
               Grid.Row="1" x:Name="pl2Sprite" Source="" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="-1"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <Rectangle Grid.Row="2" Grid.Column="0" Fill="ForestGreen" />

        <ScrollViewer x:Name="Scroll" Grid.Column="0" Grid.Row="2" 
                      Style="{StaticResource ScrollBackground}">

            <TextBlock x:Name="roundInfo" 
                       Style="{StaticResource RoundInfo}" 
                       Text="Placeholder"
                       SizeChanged="roundInfo_SizeChanged"/>

        </ScrollViewer>

        <Grid Grid.Row="2" Grid.Column="1" Background="ForestGreen">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Button Template="{DynamicResource ButtonTemplateNew}" 
                    Grid.Column="0" Grid.Row="0" Content="Attack"
                    x:Name="AttackBtn" Click="Attack_Click"/>

            <Button Template="{DynamicResource ButtonTemplateNew}" 
                    x:Name="BlockBtn" Grid.Column="0" 
                    Grid.Row="1" Content="Block"
                    Grid.ColumnSpan="2" Click="Block_Click"/>

            <Button Template="{DynamicResource ButtonTemplateNew}"
                    x:Name="HealBtn" Grid.Column="1" 
                    Grid.Row="0" Content="Heal"
                    Click="Heal_Click"/>

        </Grid>
    </Grid>
</Window>
